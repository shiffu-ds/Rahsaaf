# Copy this file to .env and fill it in. Never commit .env or share the token.

# --- Telegram alerts ----------------------------------------------------------
# 1. In Telegram, talk to @BotFather, send /newbot, and copy the token it gives.
# 2. Open your new bot and press Start (or add it to a group and say something).
# 3. Run:  uv run python tools/telegram_setup.py
#    It prints the chat ID to put below, and can send a test message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Also send a map pin after the photo.
TELEGRAM_SEND_LOCATION=true

# --- Server -------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Address officers use to reach this server; used for links in alerts.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Optional shared secret between the camera worker and the server. Leave empty
# when both run on the same machine: the server then accepts reports only from
# this machine. Set it when the worker runs on another computer.
INTERNAL_API_KEY=
DATABASE_PATH=data/rahsaaf.db
EVIDENCE_DIR=data/evidence
TIMEZONE=Asia/Karachi
